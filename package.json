{
  "name": "use-scramble",
  "author": "Tolis Christodoulou <me@tol.is>",
  "homepage": "https://use-scramble.dev",
  "repository": "https://github.com/tol-is/use-scramble",
  "description": "React hook for random text animations",
  "keywords": [
    "typescript",
    "react",
    "hook",
    "animation",
    "scramble",
    "typewriter",
    "random text",
    "text animation",
    "randomizer",
    "yugop"
  ],
  "version": "2.2.15",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "dev": "concurrently \"yarn start\" \"yarn playground\"",
    "playground": "parcel playground/index.html",
    "start": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsc --noEmit"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "./dist/index.js",
      "import": "{ useScramble }",
      "limit": "1KB"
    },
    {
      "path": "./dist/index.mjs",
      "import": "{ useScramble }",
      "limit": "1KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^4.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "concurrently": "^7.6.0",
    "husky": "^8.0.2",
    "iphigenia-in-aulis": "^1.0.0",
    "jsdom": "^24",
    "leva": "^0.9.34",
    "parcel": "^2.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "size-limit": "^4.8.0",
    "tslib": "^2.4.1",
    "tsup": "^8.5.1",
    "typescript": "^4.9.3",
    "vitest": "^2"
  },
  "peerDependencies": {
    "react": ">=16",
    "react-dom": ">=16"
  }
}
